{
    "name": "phpsoftbox/validator",
    "description": "Validator component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "ext-fileinfo": "*",
        "phpsoftbox/collection": "dev-master",
        "phpsoftbox/filter": "dev-master",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpsoftbox/http-message": "dev-master",
        "phpsoftbox/session": "dev-master",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Validator\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "phpsoftbox/validator-db": "Provides database-backed exists and unique validation rules."
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
